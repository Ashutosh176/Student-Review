# Copy to .env and fill in real values. NEVER commit .env.

# PostgreSQL connection string. Use a free-tier provider (Neon, Supabase, Railway) in dev.
DATABASE_URL="postgresql://user:password@localhost:5432/studentreview?schema=public"

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cookies
COOKIE_SECRET=replace-with-a-long-random-string

# Email (abstracted — swap provider in src/services/email.service.ts)
# "console" just logs; "resend" needs RESEND_API_KEY; "msg91" needs the
# MSG91_* block below.
EMAIL_PROVIDER=console
# resend.com free tier (3,000/mo, 100/day) — Dashboard → API Keys. No domain
# verification needed to start: leave EMAIL_FROM as their shared test sender.
EMAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=

# MSG91 transactional email (control.msg91.com). Requires: a verified sending
# domain (Email → Domains → add domain → add the TXT/MX records it gives you
# at your DNS provider) and one approved template per email below (Email →
# Templates). See conversation notes for the full setup walkthrough.
MSG91_AUTH_KEY=
MSG91_DOMAIN=
MSG91_FROM_EMAIL=
MSG91_FROM_NAME=StudentReview
# Template IDs (Email → Templates → copy the template_id after approval).
# Each template must define the listed variables as ##VAR## placeholders.
MSG91_TEMPLATE_VERIFY_EMAIL=
MSG91_TEMPLATE_RESET_PASSWORD=
MSG91_TEMPLATE_COLLEGE_OTP=
MSG91_TEMPLATE_SAVED_COLLEGE_REVIEW=

# "Students say..." AI summary per college (Console → Settings → API Keys).
# Leave blank to keep the feature off — no error, the summary section just
# never appears.
ANTHROPIC_API_KEY=

# File storage (local dev; swap for S3-compatible provider later)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Razorpay (test mode — Dashboard → Settings → API Keys → Generate Test Key,
# no KYC/live account needed). Leave blank to keep billing disabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks. Only reachable from a public HTTPS URL
# (e.g. via ngrok in dev) — the checkout /verify call is what activates a
# plan on localhost; the webhook is a production reconciliation backup.
RAZORPAY_WEBHOOK_SECRET=
