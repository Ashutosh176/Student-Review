# Copy to .env and fill in real values. NEVER commit .env.

# PostgreSQL connection string. Use a free-tier provider (Neon, Supabase, Railway) in dev.
DATABASE_URL="postgresql://user:password@localhost:5432/studentreview?schema=public"

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cookies
COOKIE_SECRET=replace-with-a-long-random-string

# Email (abstracted — swap provider in src/services/email.service.ts)
# "console" just logs; set to "resend" + RESEND_API_KEY to actually send.
EMAIL_PROVIDER=console
# resend.com free tier (3,000/mo, 100/day) — Dashboard → API Keys. No domain
# verification needed to start: leave EMAIL_FROM as their shared test sender.
EMAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=

# File storage (local dev; swap for S3-compatible provider later)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Razorpay (test mode — Dashboard → Settings → API Keys → Generate Test Key,
# no KYC/live account needed). Leave blank to keep billing disabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks. Only reachable from a public HTTPS URL
# (e.g. via ngrok in dev) — the checkout /verify call is what activates a
# plan on localhost; the webhook is a production reconciliation backup.
RAZORPAY_WEBHOOK_SECRET=
